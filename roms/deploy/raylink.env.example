NODE_ENV=production
RAYLINK_HOST=127.0.0.1
RAYLINK_PORT=4173
RAYLINK_PUBLIC_ORIGIN=https://panel.example.com
RAYLINK_TRUST_PROXY=true
RAYLINK_ADMIN_USERNAME=admin
RAYLINK_ADMIN_PASSWORD=replace-with-a-long-random-secret
RAYLINK_DATA_DIR=/var/lib/raylink
RAYLINK_PROXY_HOST=node.example.com
RAYLINK_PROXY_PORT=8388
RAYLINK_RUNTIME_MODE=systemd
RAYLINK_USER_METERING=true
SING_BOX_BIN=/usr/local/bin/raylink-sing-box
SING_BOX_SYSTEMD_UNIT=sing-box-raylink.service

# 仅新安装首次启动使用。已有实例保持 false；一次性令牌只能保存 SHA-256 base64url 哈希。
RAYLINK_SETUP_REQUIRED=false
# RAYLINK_SETUP_TOKEN_HASH=
# RAYLINK_SETUP_TOKEN_EXPIRES_AT=
