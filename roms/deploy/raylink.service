[Unit]
Description=RayLink sing-box control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/raylink
EnvironmentFile=/etc/raylink/raylink.env
ExecStart=/usr/bin/node /opt/raylink/server/index.js
Restart=on-failure
RestartSec=3
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/raylink
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
