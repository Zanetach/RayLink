# First-run HTTPS entry point. The installer replaces the two __RAYLINK_*__
# placeholders and generates a local certificate with an IP subjectAltName.
map $uri $raylink_loggable {
    default 1;
    ~^/sub/ 0;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name _;

    ssl_certificate /etc/raylink/tls/control-plane.crt;
    ssl_certificate_key /etc/raylink/tls/control-plane.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    access_log /var/log/nginx/raylink.access.log combined if=$raylink_loggable;
    error_log /var/log/nginx/raylink.error.log warn;

    location / {
        proxy_pass http://127.0.0.1:4173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
