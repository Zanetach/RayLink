RAYLINK_HOST=127.0.0.1
RAYLINK_PORT=4173
RAYLINK_DATA_DIR=./data
RAYLINK_ADMIN_USERNAME=admin
RAYLINK_ADMIN_PASSWORD=change-this-before-production
RAYLINK_PUBLIC_ORIGIN=http://127.0.0.1:4173
RAYLINK_SUBSCRIPTION_ORIGIN=http://127.0.0.1:4173
RAYLINK_SUBSCRIPTION_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
RAYLINK_TRUST_PROXY=false
RAYLINK_RUNTIME_MODE=dry-run
RAYLINK_PROTOCOL_PROBE_URL=https://www.gstatic.com/generate_204
RAYLINK_BACKUP_DIR=./data/backups
RAYLINK_BACKUP_RETENTION_COUNT=14
RAYLINK_BACKUP_INTERVAL_MS=86400000
RAYLINK_ALERT_WEBHOOK_URL=
RAYLINK_ALERT_INTERVAL_MS=60000
SING_BOX_BIN=/usr/local/bin/raylink-sing-box
SING_BOX_SYSTEMD_UNIT=sing-box.service
RAYLINK_USER_METERING=true
